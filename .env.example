# Local development defaults. Copy to .env (git-ignored). Prefix: AURANEXUS_
AURANEXUS_ENV=local
AURANEXUS_AUTH_MODE=dev            # dev | oidc   (dev is refused unless ENV=local)
AURANEXUS_STORE_BACKEND=memory     # memory | postgres
# AURANEXUS_DATABASE_URL=postgresql+psycopg://auranexus_app:app@localhost:5432/auranexus

# LLM: fake (offline, returns no items) | gemini (Gemini on Vertex AI) | claude (Claude on Vertex AI)
# gemini needs `pip install -e .[gcp]` + ADC; claude additionally needs `.[claude]`.
AURANEXUS_LLM_BACKEND=fake
# AURANEXUS_GCP_PROJECT=my-project
# AURANEXUS_VERTEX_REGION=global
# AURANEXUS_MODEL=gemini-2.5-pro     # empty = backend default; confirm the id/quota in your region
# AURANEXUS_TEMPERATURE=0.0          # gemini only
# AURANEXUS_EFFORT=medium            # claude only

AURANEXUS_BUS_BACKEND=memory       # memory | pubsub
# AURANEXUS_PUBSUB_TOPIC_PREFIX=auranexus-dev
AURANEXUS_ANALYTICS_BACKEND=null   # null | bigquery
# AURANEXUS_BIGQUERY_DATASET=auranexus_dev

# oidc mode only
# AURANEXUS_OIDC_AUDIENCE=https://auranexus-api-dev-<project-number>.asia-south1.run.app
# AURANEXUS_INTERNAL_SERVICE_ACCOUNTS=["auranexus-pubsub-dev@proj.iam.gserviceaccount.com"]
